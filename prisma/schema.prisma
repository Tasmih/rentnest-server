// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}
enum PropertyType {
  FLAT
  ROOM
  SEAT
  SUBLET
  HOSTEL
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  RENTED
  INACTIVE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum FavoriteStatus {
  ACTIVE
  REMOVED
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  phone     String?
  role      UserRole   @default(TENANT)
  status    UserStatus @default(ACTIVE)
  properties Property[]
  rentalRequests RentalRequest[]
  reviews Review[]
  favorites Favorite[]

  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Category {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  status      CategoryStatus @default(ACTIVE)
  properties Property[]
  

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("categories")
}

model Property {
  id          String         @id @default(uuid())
  title       String
  description String
  rent        Int
  area        String
  address     String
  propertyType PropertyType
  bedrooms    Int?
  bathrooms   Int?
  coverImage  String?

  furnished       Boolean @default(false)
  parking         Boolean @default(false)
  lift            Boolean @default(false)
  bachelorAllowed Boolean @default(true)
  familyAllowed   Boolean @default(true)

  landlordId String
  categoryId String

  landlord User     @relation(fields: [landlordId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  rentalRequests RentalRequest[]
  reviews Review[]
  favorites Favorite[]

  status    PropertyStatus @default(AVAILABLE)
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([landlordId])
  @@index([categoryId])
  @@index([status])
  @@index([area])
  @@index([rent])
  @@map("properties")
}

model RentalRequest {
  id         String        @id @default(uuid())
  moveInDate DateTime?
  message    String?

  tenantId   String
  propertyId String

  tenant   User     @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  status    RequestStatus @default(PENDING)
  isDeleted Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@map("rental_requests")
}

model Review {
  id         String       @id @default(uuid())
  rating     Int
  comment    String?

  userId     String
  propertyId String

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  status    ReviewStatus @default(PUBLISHED)
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@map("reviews")
}

model Favorite {
  id         String         @id @default(uuid())

  userId     String
  propertyId String

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  status    FavoriteStatus @default(ACTIVE)
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@map("favorites")
}